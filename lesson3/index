<body>
<div id="app"><aside class="rail" id="rail"><div class="brand"><div class="brand-mark">NG<span>✳</span></div><div><div class="brand-title">THE ULTIMATE TIER LIST</div></div></div><nav class="nav-list" id="nav"></nav></aside><main class="main"><header class="topbar"><div><button id="menu" class="ghost-btn mobile-menu" aria-label="Open menu">☰</button> </div></header><div class="reading"><div id="pageIntro"></div><article id="content"></article><div class="footer-nav"><button id="prev" class="nav-button">← Back</button><span class="count" id="counter"></span><button id="next" class="nav-button primary">Next page →</button></div></div></main></div>
<script>
'use strict';
const STORAGE='new-general-kristina-tier-list-clean-v2';
const empty=()=>({answers:{},visited:{},checked:{},tierItems:[],page:0,finished:false});
let state=empty();try{state={...state,...JSON.parse(localStorage.getItem(STORAGE)||'{}')}}catch(e){}
const save=()=>{try{localStorage.setItem(STORAGE,JSON.stringify(state))}catch(e){}};
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const norm=s=>String(s??'').toLowerCase().trim().replace(/[“”‘’]/g,"'").replace(/[^a-z0-9' -]/g,' ').replace(/\s+/g,' ');
const keys={};const pages=[];let page=state.page||0;
function add(title,kind,mins,html,group){pages.push({title,kind,mins,html,group})}
function section(title,html){return `<section class="section"><div class="section-kicker">${title}</div>${html}</section>`}
function prompt(txt){return `<p class="lead">${txt}</p>`}
function note(txt){return ''}
function open(id,label,placeholder='Write your answer...',rows=2){let v=state.answers[id]||'';return `<label class="free-label" for="${id}">${label}</label><textarea class="free-input ${rows===1?'free-small':''}" rows="${rows}" id="${id}" data-input="${id}" placeholder="${esc(placeholder)}">${esc(v)}</textarea>`}
function radio(id,q,opts,correct,explanation=''){keys[id]={type:'radio',correct,explanation};return `<div class="quiz" data-quiz="${id}"><p class="qprompt">${q}</p><div class="answers">${opts.map((o,i)=>`<label class="answer-option"><input type="radio" name="${id}" value="${i}" data-radio="${id}" ${String(state.answers[id])===String(i)?'checked':''}><span>${o}</span></label>`).join('')}</div><div class="feedback" data-feedback="${id}"></div></div>`}
function gap(id,before,after,ans){keys[id]={type:'gap',correct:ans};const value=state.answers[id]||'';return `<div class="gap-line" data-quiz="${id}">${before} <input type="text" aria-label="Complete the sentence" data-input="${id}" value="${esc(value)}" autocomplete="off" placeholder="..."> ${after}<div class="feedback" data-feedback="${id}"></div></div>`}
function choice(id,opts,correct){keys[id]={type:'choice',correct};let value=state.answers[id]??'';return `<select aria-label="Choose the correct form" data-choice="${id}" class="inline-choice" data-quiz="${id}"><option value="">Choose...</option>${opts.map((o,i)=>`<option value="${i}" ${String(value)===String(i)?'selected':''}>${esc(o)}</option>`).join('')}</select>`}
function checkbar(label='Check answers'){return `<div class="checkbar"><span class="feedback" data-page-result></span><button type="button" class="check-btn" data-checkpage>${label}</button></div>`}
function qsection(title,body){return section(title,body+checkbar())}
function ruleTitle(n,title){return `<div class="rule-head"><span class="rule-index">RULE ${n}</span><h3>${title}</h3></div>`}
